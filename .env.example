# Bridge Stage 1 provider credentials.
# Do not use production or customer data in this spike.

DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Only required when running with --tts-provider elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Defaults are intentionally easy to override.
DEEPGRAM_MODEL=nova-3
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
ELEVENLABS_MODEL=eleven_multilingual_v2
